# Ignore everything by default, then explicitly allow the skill content

*

# Keep local release/package outputs out of git
release/
*.zip
*.tmp
*.temp
tmp/
temp/
staging/
package/

# Allow the skill itself
!SKILL.md
!routing-index.md
!README.md
!process.md
!.gitignore
!.gitattributes

# Allow root licensing and attribution documents
!/LICENSE
!/LICENSE.md
!/NOTICE
!/NOTICE.md

# Allow maintenance scripts
!scripts/
!scripts/**
scripts/**/__pycache__/
scripts/**/*.pyc

# Allow lightweight source audit artifacts, but keep raw/rendered Apple source captures ignored
!sources/
!sources/*/
!sources/*/inventory.json
!sources/*/failures.json
!sources/*/capture-summary.json
!sources/*/dispositions.md
!sources/*/disposition-overrides.json
!sources/*/verification/
!sources/*/verification/**
sources/*/raw/
sources/*/rendered/
sources/*/native/
sources/*/diffs/
sources/*/supplements/
sources/*/cache/
sources/*/caches/
sources/*/normalized/
sources/*/tmp/
sources/*/temp/

# Allow the distilled reference files
!distilled/
!distilled/**

# Selected September runtime instructions and README illustrations
!references/
!references/enforce.md
!references/enforce-format.md
!references/duo.md
!references/duo-checklist.md
!commands/
!commands/duo.md
!references/hig/
!references/hig/**
!tests/
!tests/test_hig_enforce.py
!tests/test_hig_route.py
!docs/
!docs/readme-graphics/
!docs/readme-graphics/2026-09-12/
!docs/readme-graphics/2026-09-12/01-header-light.png
!docs/readme-graphics/2026-09-27/
!docs/readme-graphics/2026-09-27/**

# Verified September reference-corpus summary and compact reproducible accounting
!docs/corpus-2026-09-12/
!docs/corpus-2026-09-12/**


# Current shipping assessment
!docs/release-2026-09-21/
!docs/release-2026-09-21/**
!docs/release-2026-09-27/
!docs/release-2026-09-27/**
